{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coocoo-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coocoo-db",
      "database_id": "6854c887-b45b-4103-a959-dcf41c8e7b24"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
